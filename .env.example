AICC_ENV=development
AICC_JWT_SECRET=aicc-dev-secret-change-me-in-production
AICC_FIRST_USER_IS_SUPERUSER=true
AICC_DATABASE_URL=postgresql+asyncpg://aicc:aicc-dev-password@postgres:5432/aicc
AICC_DATABASE_POOL_SIZE=5
AICC_DATABASE_MAX_OVERFLOW=10
AICC_DATABASE_POOL_TIMEOUT_SECONDS=30
AICC_DATABASE_POOL_RECYCLE_SECONDS=1800
POSTGRES_DB=aicc
POSTGRES_USER=aicc
POSTGRES_PASSWORD=aicc-dev-password
AICC_LLM_MODEL=openai:gpt-4o-mini
AICC_LLM_API_KEY=
AICC_LLM_BASE_URL=
AICC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
