VITE_ENV=standalone
VITE_API_SERVER_URL=http://localhost:8080
VITE_AI_SERVER_URL=http://127.0.0.1:8000
VITE_AUTH0_DOMAIN=secret
VITE_AUTH0_CLIENT_ID=secret
VITE_AUTH0_CALLBACK_URL=http://localhost:3000
VITE_AUTH0_AUDIENCE=secret
# Cesium Ion access token: https://cesium.com/ion/tokens
VITE_CESIUM_ION_TOKEN=
# Optional satellite imagery override. The default uses Gaode satellite imagery.
# Use an XYZ/WMTS-style URL template with {z}/{x}/{y}, then set the max
# available zoom level to avoid provider placeholder tiles when zooming in.
VITE_CESIUM_SATELLITE_TILE_URL=
VITE_CESIUM_SATELLITE_MAX_LEVEL=16
