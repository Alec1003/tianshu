FROM docker.m.daocloud.io/library/node:20-alpine AS build

WORKDIR /app

ARG VITE_ENV=standalone
ARG VITE_API_SERVER_URL=
ARG VITE_AI_SERVER_URL=
ARG VITE_AUTH0_DOMAIN=
ARG VITE_AUTH0_CLIENT_ID=
ARG VITE_AUTH0_CALLBACK_URL=
ARG VITE_AUTH0_AUDIENCE=
ARG VITE_CESIUM_ION_TOKEN=
ARG VITE_CESIUM_SATELLITE_TILE_URL=
ARG VITE_CESIUM_SATELLITE_MAX_LEVEL=16
ARG VITE_CESIUM_ARCGIS_IMAGERY_TILE_URL=
ARG VITE_CESIUM_ARCGIS_IMAGERY_MAX_LEVEL=19
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG ALL_PROXY=
ARG NO_PROXY=

ENV VITE_ENV=$VITE_ENV
ENV VITE_API_SERVER_URL=$VITE_API_SERVER_URL
ENV VITE_AI_SERVER_URL=$VITE_AI_SERVER_URL
ENV VITE_AUTH0_DOMAIN=$VITE_AUTH0_DOMAIN
ENV VITE_AUTH0_CLIENT_ID=$VITE_AUTH0_CLIENT_ID
ENV VITE_AUTH0_CALLBACK_URL=$VITE_AUTH0_CALLBACK_URL
ENV VITE_AUTH0_AUDIENCE=$VITE_AUTH0_AUDIENCE
ENV VITE_CESIUM_ION_TOKEN=$VITE_CESIUM_ION_TOKEN
ENV VITE_CESIUM_SATELLITE_TILE_URL=$VITE_CESIUM_SATELLITE_TILE_URL
ENV VITE_CESIUM_SATELLITE_MAX_LEVEL=$VITE_CESIUM_SATELLITE_MAX_LEVEL
ENV VITE_CESIUM_ARCGIS_IMAGERY_TILE_URL=$VITE_CESIUM_ARCGIS_IMAGERY_TILE_URL
ENV VITE_CESIUM_ARCGIS_IMAGERY_MAX_LEVEL=$VITE_CESIUM_ARCGIS_IMAGERY_MAX_LEVEL
ENV HTTP_PROXY=$HTTP_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY
ENV ALL_PROXY=$ALL_PROXY
ENV NO_PROXY=$NO_PROXY

COPY package.json package-lock.json ./
RUN npm install -g npm@11.6.0
RUN npm ci && test -x ./node_modules/.bin/tsc

COPY . .
RUN npm run build

FROM docker.m.daocloud.io/library/nginx:1.27-alpine

EXPOSE 3002

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:3002/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
